{
  "name": "dataerror",
  "version": "1.1.0",
  "description": "A minimal type-safe error-handling library",
  "keywords": [
    "data",
    "error",
    "error handling",
    "library",
    "minimal",
    "lightweight",
    "typescript",
    "package",
    "npm"
  ],
  "homepage": "https://github.com/owenwexler/dataerror#readme",
  "bugs": {
    "url": "https://github.com/owenwexler/dataerror/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owenwexler/dataerror.git"
  },
  "license": "ISC",
  "author": "Owen Wexler",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "lint": "npx eslint .",
    "test": "vitest",
    "build:esm": "tsc",
    "build:cjs": "tsc -p tsconfig.cjs.json && mv dist-cjs/index.js dist/index.cjs && mv dist-cjs/index.d.ts dist/index.d.cts && rm -rf dist-cjs",
    "build": "npm run build:esm && npm run build:cjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  }
}
